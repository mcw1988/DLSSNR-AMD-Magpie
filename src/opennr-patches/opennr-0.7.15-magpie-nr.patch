+// Stands down when the active Magpie scaling group belongs to another backend, so switching
+// groups in Magpie's UI cannot leave two runtimes fighting over the same frame. Reads
+// config\v4e\config.json beside Magpie.exe on a one-second cadence; the active group is the one
+// profiles[0] points at, matched by name first and by the effects it holds as the fallback --
+// the same rule nr-router applies, only now it does not need to be run by hand. A config it
+// cannot read keeps the previous decision, so a half-written file cannot flap the engine.
+bool GroupWantsThisBackend()
+{
+    static ULONGLONG lastCheck = 0;
+    static bool wanted = true;
+    const ULONGLONG now = GetTickCount64();
+    if (now - lastCheck < 1000)
+        return wanted;
+    lastCheck = now;
+
+    wchar_t exe[MAX_PATH] {};
+    GetModuleFileNameW(nullptr, exe, MAX_PATH);
+    std::wstring path(exe);
+    const size_t slash = path.find_last_of(L"\\/");
+    if (slash == std::wstring::npos)
+        return wanted;
+    path.resize(slash + 1);
+    path += L"config\\v4e\\config.json";
+
+    FILE* f = nullptr;
+    if (_wfopen_s(&f, path.c_str(), L"rb") != 0 || f == nullptr)
+        return wanted;
+    std::string text;
+    char buf[1 << 16];
+    size_t got = 0;
+    while ((got = fread(buf, 1, sizeof buf, f)) > 0)
+        text.append(buf, got);
+    fclose(f);
+    if (text.empty())
+        return wanted;
+
+    const char* modesAt = strstr(text.c_str(), "\"scalingModes\"");
+    const char* scalingAt = strstr(text.c_str(), "\"scalingMode\"");
+    if (modesAt == nullptr || scalingAt == nullptr)
+        return wanted;
+    const char* colon = strchr(scalingAt, ':');
+    if (colon == nullptr)
+        return wanted;
+    const int index = atoi(colon + 1);
+    if (index < 0)
+        return wanted;
+
+    // A group name is a "name" whose value is followed by "effects"; effect entries carry
+    // "scalingType" or "parameters" instead, so they are not mistaken for groups.
+    auto quotedAfter = [](const char* at) -> std::string {
+        const char* p = strchr(at, ':');
+        if (p == nullptr)
+            return {};
+        while (*p != '\0' && *p != '"')
+            ++p;
+        if (*p == '\0')
+            return {};
+        ++p;
+        const char* e = strchr(p, '"');
+        return e == nullptr ? std::string() : std::string(p, e - p);
+    };
+    std::vector<std::string> groups;
+    std::vector<const char*> starts;
+    for (const char* p = modesAt; (p = strstr(p, "\"name\":")) != nullptr; ++p) {
+        const char* nextName = strstr(p + 1, "\"name\":");
+        const char* effects = strstr(p, "\"effects\"");
+        if (effects != nullptr && (nextName == nullptr || effects < nextName)) {
+            groups.push_back(quotedAfter(p));
+            starts.push_back(p);
+        }
+    }
+    if (index >= static_cast<int>(groups.size()))
+        return wanted;
+
+    const std::string& active = groups[index];
+    std::string lower;
+    for (char c : active)
+        lower += static_cast<char>(tolower(static_cast<unsigned char>(c)));
+
+    bool ours = false;
+    if (lower.find("mochi") != std::string::npos)
+        ours = true;
+    else if (lower.find("lmxxf") != std::string::npos || lower.find("dlss5") != std::string::npos)
+        ours = false;
+    else {
+        // Name says nothing: decide on which hook the group carries. AMDNR-ACO is this route
+        // (mochizuki, ACO kernels), AMDNR-HIP is lmxxf's (HIP). The older XeSS_SR / FSR*_SR
+        // stubs are still accepted so a group that was not migrated keeps working.
+        const char* begin = starts[index];
+        const char* end = index + 1 < static_cast<int>(starts.size()) ? starts[index + 1]
+                                                                     : text.c_str() + text.size();
+        const std::string slice(begin, end);
+        const bool acoHook = slice.find("AMDNR-ACO") != std::string::npos ||
+                             slice.find("XeSS_SR") != std::string::npos;
+        const bool hipHook = slice.find("AMDNR-HIP") != std::string::npos ||
+                             slice.find("FSR3_SR") != std::string::npos ||
+                             slice.find("FSR4_SR") != std::string::npos;
+        ours = acoHook && !hipHook;
+    }
+
+    static bool said = false;
+    if (ours != wanted || !said)
+        Log("group: \"%s\" is active; this add-on %s.", active.c_str(),
+            ours ? "runs it" : "stands down for another backend");
+    said = true;
+    wanted = ours;
+    return wanted;
+}
