+bool FSR3Upscaler::Drain() noexcept {
+	if (!_impl) return true;
+	Impl& impl = *_impl;
+	if (impl.failed) return false;
+	if (!impl.queue12 || !impl.fence12 || !impl.context11) return true;
+	// 等所有已提交的岛完成：WaitForQueue 在新的围栏值上信号一次再等它完成，
+	// 因为围栏值单调，这条等待同时覆盖了所有槽更早的 islandValue。
+	if (!WaitForQueue(impl)) {
+		impl.failed = true;
+		Logger::Get().Error("Wait FSR3 D3D12 queue drain failed");
+		return false;
+	}
+	for (Impl::Slot& slot : impl.slots) slot.pending = false;
+	// Drain() 只等不补拷（2026-11-03 裁决，优先于 multislot.md §3.8）：发布路径
+	// Renderer.cpp:4614-4624 已经对最后一帧做过 Signal + Flush + 等围栏，那一帧
+	// 早就进呈现环交给系统了；而 Drain() 没有目标纹理参数，缓存 ctx.output 指针在
+	// Resize() 之后立即悬空。lag=0 时 FIFO 恒空，所以 results 恒为 0。
+	Logger::Get().Info(fmt::format("fsr3-slot: drain islands={} results=0", impl.drawSerial));
+	return true;
+}
