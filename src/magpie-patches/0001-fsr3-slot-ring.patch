+// 环境变量只接受十进制非负整数；无法解析时返回 fallback（不报错，按 multislot.md §5 回落默认）。
+static uint32_t ReadEnvUint(const wchar_t* name, uint32_t fallback) noexcept {
+	wchar_t buffer[16]{};
+	const DWORD length = GetEnvironmentVariableW(name, buffer, (DWORD)std::size(buffer));
+	if (!length || length >= (DWORD)std::size(buffer)) return fallback;
+	uint32_t value = 0;
+	for (const wchar_t* p = buffer; *p; ++p) {
+		if (*p < L'0' || *p > L'9') return fallback;
+		value = value * 10 + (uint32_t)(*p - L'0');
+		if (value > 4096) return fallback;
+	}
+	return value;
+}
